{
	"extends": "@rtorcato/repo-tooling/typescript/base",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"lib": ["ES2022"],
		"rootDir": "src",
		"outDir": "dist",
		"noEmit": false,
		"declaration": false,
		"sourceMap": false,
		"incremental": false,
		"types": ["node"],
		"resolveJsonModule": true,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": ["src/**/*.ts"]
}
